<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.tuxkart</groupId>
  <artifactId>supertuxkart-java</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>TuxKart Java</name>
  <description>Clone du jeu de kart TuxKart, ecrit en Java 26 + JavaFX</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>26</maven.compiler.release>
    <javafx.version>26.0.2</javafx.version>
    <junit.version>6.1.3</junit.version>
    <main.class>org.tuxkart.TuxKartApp</main.class>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <!-- uniquement pour ecrire les captures d'ecran en PNG (touche F12) -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-swing</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>tuxkart</finalName>
    <plugins>
      <!--
        Le projet exige Java 26, que Maven tourne dessus ou non : sans cela, un
        « mvn package » lance avec un JDK plus ancien echoue sur un « release
        version 26 not supported » deroutant. Le toolchain fait compiler et
        tester par le JDK declare dans ~/.m2/toolchains.xml, ce qui laisse le
        JDK du systeme libre pour les autres projets.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-toolchains-plugin</artifactId>
        <version>3.3.0</version>
        <executions>
          <execution>
            <goals><goal>select-jdk-toolchain</goal></goals>
          </execution>
        </executions>
        <configuration>
          <version>[26,)</version>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
          <configuration>
              <source>22</source>
              <target>22</target>
          </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <configuration>
          <!-- les tests demarrent le moteur JavaFX : meme autorisation qu'ailleurs -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>

      <!--
        run.sh appelle « dependency:build-classpath » : sans version fixee ici,
        Maven en choisirait une au gre de sa propre version, et la construction
        cesserait d'etre reproductible.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
      </plugin>

      <!--
        mvn javafx:run

        Ce plugin place JavaFX sur le module path : l'appelant des fonctions
        natives est donc le module javafx.graphics, et non le module sans nom
        comme dans les deux autres modes de lancement. D'ou un drapeau
        different de celui du jar et de run.sh.
      -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
          <options>
            <option>--enable-native-access=javafx.graphics</option>
          </options>
        </configuration>
      </plugin>

      <!-- jar auto-portant : java -jar target/tuxkart.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.tuxkart.Launcher</mainClass>
                  <manifestEntries>
                    <!--
                      JavaFX charge ses bibliotheques natives par System.load().
                      Depuis Java 24 le JDK avertit, et une version future
                      refusera l'appel : on l'autorise donc explicitement. Le
                      jar embarque JavaFX, qui arrive par le classpath, d'ou le
                      module sans nom.
                    -->
                    <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
